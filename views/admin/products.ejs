<% include ../include/head.ejs %>
<% include ../include/header.ejs %>
<div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/dashboard">Overview</a><span>/</span><span>Catalog</span></nav><div class="section-heading"><div class="page-intro"><span class="eyebrow">Your collection</span><h1>Product catalog.</h1><p>All your products, at a glance.</p></div><a class="button outline" href="/shop">View storefront &#8599;</a></div><div class="table-wrap"><table><thead><tr><th scope="col">Reference</th><th scope="col">Product</th><th scope="col">Category</th><th scope="col">Price</th><th scope="col">Details</th></tr></thead><tbody><% productList.forEach(function(product){ %><tr><td>TS-<%= String(product.pid).padStart(4,'0') %></td><td><strong><%= product.title %></strong></td><td><%= product.name || product.category %></td><td><%= money(product.price) %> DA</td><td><a href="/product/<%= product.pid %>">View product &#8599;</a></td></tr><% }); %></tbody></table></div><p class="muted" style="margin-bottom:50px"><%= productList.length %> products in the collection. Catalog editing is not available in this preview.</p></div>
<% include ../include/footer.ejs %>
