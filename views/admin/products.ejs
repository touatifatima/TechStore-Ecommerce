<% include ../include/head.ejs %>
<% include ../include/header.ejs %>
<main class="container admin-catalog">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/dashboard">Overview</a><span>/</span><span>Product catalog</span></nav>
  <div class="section-heading"><div class="page-intro"><span class="eyebrow">Store management</span><h1>Your product catalog.</h1><p>Add products, update prices and descriptions, or remove items from your storefront.</p></div><a class="button" href="/admin/products/new">Add a product <span aria-hidden="true">+</span></a></div>
  <nav class="admin-tabs" aria-label="Store administration"><a class="admin-tab" href="/admin/orders">Manage orders</a><a class="admin-tab active" href="/admin/products" aria-current="page">Manage products</a><a class="admin-tab" href="/dashboard">Overview</a></nav>
  <% if(saved){ %><p class="admin-notice" role="status">Your product changes have been saved.</p><% } %><% if(deleted){ %><p class="admin-notice" role="status">The product was removed from your catalog.</p><% } %>
  <% if(productList.length){ %><div class="admin-product-list"><% productList.forEach(function(product){ %><article class="admin-product-card"><% if(product.picture === '/images/catalog/product-photo-sheet.png' && product.pid <= 24){ %><div class="product-photo" role="img" aria-label="Photo of <%= product.title %>" style="--photo-x:<%= ((product.pid - 1) % 6) * 20 %>%;--photo-y:<%= Math.floor((product.pid - 1) / 6) * 100 / 3 %>%"></div><% } else { %><img src="<%= productImage(product.picture) %>" data-fallback="/images/product-placeholder.svg" alt="" width="100" height="100"><% } %><div class="admin-product-info"><span class="product-category"><%= product.name || 'Category ' + product.category %></span><h2><%= product.title %></h2><span class="price"><%= money(product.price) %> DA</span><p><%= product.details %></p></div><div class="admin-product-actions"><a class="button outline small" href="/admin/products/<%= product.pid %>/edit">Edit</a><form action="/admin/products/<%= product.pid %>/delete" method="post" data-confirm="Remove <%= product.title %> from your storefront? Existing order receipts keep their saved product details."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button danger small" type="submit">Delete</button></form><a class="text-link product-preview" href="/product/<%= product.pid %>">View store page</a></div></article><% }); %></div><% } else { %><div class="empty-state"><h2>Your catalog is ready for its first product.</h2><p>Add a product to show it in the store.</p><a class="button" href="/admin/products/new">Add your first product +</a></div><% } %>
</main>
<% include ../include/footer.ejs %>
