<% include ../include/head.ejs %>
<% include ../include/header.ejs %>
<div class="container order-management">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/dashboard">Overview</a><span>/</span><span>Order requests</span></nav>
  <div class="page-intro"><span class="eyebrow">Gestion du magasin</span><h1>Demandes de commande.</h1><p>Consultez les demandes reçues, contactez les clients et faites évoluer leur statut jusqu'à la remise en main propre.</p></div>
  <nav class="admin-tabs" aria-label="Store administration"><a class="admin-tab active" href="/admin/orders" aria-current="page">Manage orders</a><a class="admin-tab" href="/admin/products">Manage products</a><a class="admin-tab" href="/dashboard">Overview</a></nav>
  <div class="order-counts"><% [['new','Nouvelles'],['confirmed','Confirmées'],['preparing','En préparation'],['ready','Prêtes'],['delivered','Remises'],['cancelled','Annulées']].forEach(function(pair){ const stat=counts.find(c=>c.status===pair[0]); %><div class="stat-card"><span><%= pair[1] %></span><strong><%= stat ? stat.count : 0 %></strong></div><% }); %></div>
  <% if(orders.length){ %><div class="order-list"><% orders.forEach(function(order){ %><article class="order-management-card"><div class="order-management-heading"><div><span class="eyebrow"><%= new Date(order.created_at).toLocaleString('fr-FR') %></span><h2><%= order.order_number %></h2></div><span class="order-badge order-<%= order.status %>"><%= {new:'Nouvelle',confirmed:'Confirmée',preparing:'En préparation',ready:'Prête à remettre',delivered:'Remise',cancelled:'Annulée'}[order.status] %></span></div><div class="order-customer"><div><span>Client</span><strong><%= order.customer_name %></strong><a href="mailto:<%= order.email %>"><%= order.email %></a></div><div><span>Téléphone</span><a class="customer-phone" href="tel:<%= order.phone.replace(/[^+\d]/g,'') %>"><%= order.phone %></a></div><div><span>Adresse de livraison</span><strong><%= order.address %>, <%= order.postal_code %> <%= order.city %></strong></div><div><span>Paiement</span><strong>Paiement en main propre, à la livraison</strong></div></div><details class="managed-items"><summary>Voir les <%= order.items.reduce((sum,item)=>sum+Number(item.quantity),0) %> article(s) de cette demande</summary><% order.items.forEach(function(item){ %><div class="summary-line"><span><%= item.product_name %> &times; <%= item.quantity %></span><span><%= money(Number(item.unit_price)*item.quantity) %> DA</span></div><% }); %></details><% if(order.notes){ %><p class="order-notes"><strong>Précisions pour le livreur :</strong> <%= order.notes %></p><% } %><div class="order-management-footer"><strong>Total : <%= money(order.subtotal) %> DA</strong><div class="order-admin-controls"><% if(order.status==='new'){ %><form action="/admin/orders/<%= encodeURIComponent(order.order_number) %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="confirmed"><button class="button small" type="submit">Confirmer la commande</button></form><% } %><form action="/admin/orders/<%= encodeURIComponent(order.order_number) %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="sr-only" for="status-<%= order.id %>">Statut de la commande <%= order.order_number %></label><select id="status-<%= order.id %>" name="status"><% [['new','Nouvelle demande'],['confirmed','Commande confirmée'],['preparing','En préparation'],['ready','Prête à remettre'],['delivered','Remise au client'],['cancelled','Annulée']].forEach(function(option){ %><option value="<%= option[0] %>" <%= order.status===option[0] ? 'selected' : '' %>><%= option[1] %></option><% }); %></select><button class="button small" type="submit">Mettre à jour</button></form></div></div></article><% }); %></div><% } else { %><div class="empty-state"><h2>Aucune demande pour le moment.</h2><p>Les nouvelles commandes envoyées par vos clients apparaîtront ici.</p><a class="button outline" href="/shop">Voir la boutique</a></div><% } %>
  <p class="manager-note">Espace réservé au gestionnaire. Les commandes sont classées de la plus récente à la plus ancienne.</p>
</div>
<% include ../include/footer.ejs %>
