<% include include/head.ejs %>
<% include include/header.ejs %>
<div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Overview</span></nav><div class="section-heading"><div class="page-intro"><span class="eyebrow">Store overview</span><h1>The bigger picture.</h1><p>A clear view of your product collection and customer requests.</p></div><div class="dashboard-actions"><a class="button" href="/admin/orders">Manage order requests &#8599;</a><a class="button outline" href="/admin/products">View catalog &#8599;</a></div></div><div class="dashboard-stats"><div class="stat-card"><span>Total products</span><strong><%= data.totalProducts %></strong></div><div class="stat-card"><span>Active categories</span><strong><%= data.categories.length %></strong></div><div class="stat-card"><span>Store currency</span><strong>DA</strong></div></div><section class="panel" style="margin-bottom:60px"><h2>Collection by category</h2><% data.categories.forEach(function(category){ %><div class="category-bar"><div><span><%= category.name || 'Category ' + category.category %></span><strong><%= category.category_count %> products</strong></div><progress aria-label="<%= category.name || 'Category ' + category.category %> product count" max="<%= Math.max(data.totalProducts,1) %>" value="<%= category.category_count %>"></progress></div><% }); %><% if(!data.categories.length){ %><p class="muted">Your collection is empty.</p><% } %></section></div>
<% include include/footer.ejs %>
