<% include include/head.ejs %>
<% include include/header.ejs %>
<div class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Collection</span></nav>
  <div class="page-intro"><span class="eyebrow">Find something you love</span><h1>The collection.</h1><p>Everyday favorites, all in one place. Take a look around.</p></div>
  <div class="catalog-toolbar"><div class="filter-pills" role="group" aria-label="Filter by category"><button class="filter-pill" data-filter="all" aria-pressed="true">All products</button><% [...new Set(products.map(p => p.name || 'Collection'))].forEach(function(category){ %><button class="filter-pill" data-filter="<%= category %>" aria-pressed="false"><%= category %></button><% }); %></div><label class="sort-control" for="sort">Sort by <select id="sort"><option value="featured">Featured</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option><option value="name">Name: A&ndash;Z</option></select></label></div>
  <p class="result-count" data-result-count aria-live="polite"><%= products.length %> products in the collection</p>
  <div class="product-grid" data-catalog><% products.forEach(function(product){ %><% include components/product/grid.ejs %><% }); %></div>
  <% if(!products.length){ %><div class="empty-state"><h2>Good things are on their way.</h2><p>Our collection is being prepared. Check back soon.</p></div><% } %>
  <p class="catalog-bottom">You've explored the collection. Find a favorite? Make it yours.</p>
</div>
<% include include/footer.ejs %>
