<% include include/head.ejs %>
<% include include/header.ejs %>
<div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Your bag</span></nav><div class="page-intro"><span class="eyebrow">Your favorites, together</span><h1>Your shopping bag.</h1><p>A good choice starts here. Review your items before the next step.</p></div>
<% if(products.length){ %><form action="/update-cart" method="post" class="cart-layout"><div><% products.forEach(function(product,index){ %><div class="cart-item"><a href="/product/<%= product.pid %>"><img src="<%= productImage(product.picture) %>" data-fallback="/images/product-placeholder.svg" alt="<%= product.title %>"></a><div><h2><a href="/product/<%= product.pid %>"><%= product.title %></a></h2><p><%= product.name || 'Collection' %></p><div class="quantity-row"><label class="sr-only" for="qty-<%= index %>">Quantity for <%= product.title %></label><input id="qty-<%= index %>" class="quantity-input" type="number" name="qnt[]" min="1" max="99" required value="<%= product.qnt %>"><a class="remove-link" href="/remove-from-cart/pid-<%= index %>">Remove</a></div></div><span class="price"><%= money(product.price * product.qnt) %> <small>DA</small></span></div><% }); %><div class="cart-actions"><a class="text-link" href="/shop">&#8592; Continue shopping</a><button class="button outline" type="submit">Update bag</button></div></div><aside class="summary-card"><h2>Bag summary</h2><div class="summary-line"><span>Items (<%= products.reduce((sum,p)=>sum+Number(p.qnt),0) %>)</span><span><%= money(products.reduce((sum,p)=>sum+p.price*p.qnt,0)) %> DA</span></div><div class="summary-line"><span>Delivery</span><span>Not calculated</span></div><div class="summary-line total"><span>Subtotal</span><span><%= money(products.reduce((sum,p)=>sum+p.price*p.qnt,0)) %> DA</span></div><a class="button full" href="/checkout">Review checkout <span aria-hidden="true">&#8599;</span></a><p class="summary-note">Review your details on the next page.</p><p class="summary-note"><a class="remove-link" href="/empty-cart">Empty bag</a></p></aside></form><% } else { %><div class="empty-state"><div class="empty-symbol" aria-hidden="true">+</div><h2>A little room for something new.</h2><p>Your bag is empty. Let's find your next favorite.</p><a class="button" href="/shop">Explore the collection &#8599;</a></div><% } %>
</div>
<% include include/footer.ejs %>
