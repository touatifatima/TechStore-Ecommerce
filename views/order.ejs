<% include include/head.ejs %>
<% include include/header.ejs %>
<div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/cart">Bag</a><span>/</span><span>Checkout</span></nav><div class="page-intro"><span class="eyebrow">One step closer</span><h1>The finishing touches.</h1><p>Review your bag and preview the delivery details.</p></div><div class="notice">Online ordering is not available yet. This checkout is a preview; no payment will be collected and no order will be placed.</div><div class="cart-layout"><form class="panel" data-preview-form="Your details have been checked in this browser only. Ordering is not available yet; no order was placed or information saved."><h2>Delivery details</h2><div class="form-grid"><div class="field"><label for="full-name">Full name</label><input id="full-name" name="name" autocomplete="name" required placeholder="Your full name"></div><div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com"></div></div><div class="field"><label for="address">Street address</label><input id="address" name="address" autocomplete="street-address" required placeholder="Street and house number"></div><div class="form-grid"><div class="field"><label for="city">City</label><input id="city" name="city" autocomplete="address-level2" required></div><div class="field"><label for="postal">Postal code</label><input id="postal" name="postal" autocomplete="postal-code" required></div></div><div class="field"><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" autocomplete="tel" required></div><button class="button" type="submit">Preview details &#8599;</button><p class="notice" role="status" hidden></p><noscript><p class="notice">Enable JavaScript to preview this form. Ordering is unavailable.</p></noscript></form><aside class="summary-card"><h2>Your bag</h2><% products.forEach(function(p){ %><div class="summary-line"><span><%= p.title %> × <%= p.qnt %></span><span><%= money(p.price*p.qnt) %> DA</span></div><% }); %><% if(!products.length){ %><p class="muted">Your bag is currently empty.</p><% } %><div class="summary-line total"><span>Subtotal</span><span><%= money(products.reduce((sum,p)=>sum+p.price*p.qnt,0)) %> DA</span></div><a class="text-link" href="/cart">&#8592; Edit your bag</a></aside></div></div>
<% include include/footer.ejs %>
