<% include include/head.ejs %>
<% include include/header.ejs %>
<div class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Accueil</a><span>/</span><a href="/cart">Votre panier</a><span>/</span><span>Votre demande</span></nav>
  <div class="page-intro"><span class="eyebrow">Commande avec paiement à la livraison</span><h1>Votre demande de commande.</h1><p>Indiquez où vous souhaitez recevoir votre commande. Vous réglerez en main propre à la livraison, sans paiement en ligne.</p></div>
  <% if(typeof orderError !== 'undefined' && orderError){ %><div class="order-error" role="alert"><strong>Votre demande n'a pas été enregistrée.</strong><br><%= orderError %></div><% } %>
  <div class="order-explainer"><span aria-hidden="true">01</span><p><strong>Vous envoyez votre demande</strong>Nous enregistrons vos produits et vos coordonnées.</p><span aria-hidden="true">02</span><p><strong>Nous confirmons avec vous</strong>Le magasin vous contacte pour confirmer la disponibilité.</p><span aria-hidden="true">03</span><p><strong>Vous payez à la livraison</strong>Aucun paiement n'est demandé sur ce site.</p></div>
  <div class="cart-layout order-layout">
    <form class="panel order-form" action="/checkout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2>Vos coordonnées</h2>
      <p class="panel-intro">Les champs marqués d'un astérisque sont obligatoires.</p>
      <div class="form-grid">
        <div class="field"><label for="customer-name">Nom complet <span aria-hidden="true">*</span></label><input id="customer-name" name="customer_name" value="<%= (typeof formValues !== 'undefined' && formValues.customer_name) || '' %>" autocomplete="name" maxlength="100" required placeholder="Votre nom et prénom"></div>
        <div class="field"><label for="customer-phone">Téléphone <span aria-hidden="true">*</span></label><input id="customer-phone" name="phone" value="<%= (typeof formValues !== 'undefined' && formValues.phone) || '' %>" type="tel" autocomplete="tel" minlength="7" maxlength="30" required placeholder="+213 …"></div>
      </div>
      <div class="field"><label for="customer-email">Adresse e-mail <span aria-hidden="true">*</span></label><input id="customer-email" name="email" value="<%= (typeof formValues !== 'undefined' && formValues.email) || '' %>" type="email" autocomplete="email" maxlength="254" required placeholder="vous@exemple.com"></div>
      <div class="field"><label for="customer-address">Adresse de livraison <span aria-hidden="true">*</span></label><input id="customer-address" name="address" value="<%= (typeof formValues !== 'undefined' && formValues.address) || '' %>" autocomplete="street-address" maxlength="255" required placeholder="Rue, numéro et quartier"></div>
      <div class="form-grid">
        <div class="field"><label for="customer-city">Ville <span aria-hidden="true">*</span></label><input id="customer-city" name="city" value="<%= (typeof formValues !== 'undefined' && formValues.city) || '' %>" autocomplete="address-level2" maxlength="100" required></div>
        <div class="field"><label for="customer-postal">Code postal <span aria-hidden="true">*</span></label><input id="customer-postal" name="postal_code" value="<%= (typeof formValues !== 'undefined' && formValues.postal_code) || '' %>" autocomplete="postal-code" maxlength="30" required></div>
      </div>
      <div class="field"><label for="customer-notes">Précisions pour le livreur <span class="muted">(facultatif)</span></label><textarea id="customer-notes" name="notes" maxlength="1000" placeholder="Repère, horaire souhaité ou autre précision"><%= (typeof formValues !== 'undefined' && formValues.notes) || '' %></textarea></div>
      <button class="button" type="submit">Envoyer ma demande <span aria-hidden="true">&#8594;</span></button>
      <p class="checkout-promise">L'envoi de cette demande ne déclenche aucun paiement.</p>
    </form>
    <aside class="summary-card"><h2>Récapitulatif</h2>
      <% products.forEach(function(p){ %><div class="summary-line"><span><%= p.title %> <span class="muted">&times; <%= p.qnt %></span></span><span><%= money(p.price*p.qnt) %> DA</span></div><% }); %>
      <div class="summary-line"><span>Mode de paiement</span><span class="cash-label">À la livraison</span></div>
      <div class="summary-line total"><span>Total de la demande</span><span><%= money(products.reduce((sum,p)=>sum+p.price*p.qnt,0)) %> DA</span></div>
      <p class="summary-note">Le montant final sera confirmé par le magasin avant la livraison.</p>
      <a class="text-link" href="/cart">&#8592; Modifier mon panier</a>
    </aside>
  </div>
</div>
<% include include/footer.ejs %>
