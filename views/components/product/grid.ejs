<article class="product-card" data-product data-name="<%= product.title %>" data-price="<%= product.price %>" data-category="<%= product.name || 'Collection' %>" data-index="<%= product.pid %>">
  <a class="product-image" href="/product/<%= product.pid %>"><span class="product-badge"><%= product.name || 'Collection' %></span><% if(product.picture === '/images/catalog/product-photo-sheet.png' && product.pid <= 24){ %><span class="product-photo" role="img" aria-label="Photo of <%= product.title %>" style="--photo-x:<%= ((product.pid - 1) % 6) * 20 %>%;--photo-y:<%= Math.floor((product.pid - 1) / 6) * 100 / 3 %>%"></span><% } else { %><img loading="lazy" src="<%= productImage(product.picture) %>" data-fallback="/images/product-placeholder.svg" alt="<%= product.title %>" width="400" height="440"><% } %></a>
  <div class="product-body"><span class="product-category"><%= product.name || 'Computer gear' %></span><h3 class="product-title"><a href="/product/<%= product.pid %>"><%= product.title %></a></h3><div class="product-bottom"><span class="price"><%= money(product.price) %> <small>DA</small></span><a class="add-button" href="/add-to-cart/pid-<%= product.pid %>" aria-label="Add <%= product.title %> to bag">+</a></div></div>
</article>
