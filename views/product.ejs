<% include include/head.ejs %>
<% include include/header.ejs %>
<div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/shop">Collection</a><span>/</span><span>Product details</span></nav>
<% products.forEach(function(product){ %><div class="detail-grid"><div class="detail-image"><% if(product.picture === '/images/catalog/product-photo-sheet.png' && product.pid <= 24){ %><div class="product-photo" role="img" aria-label="Photo of <%= product.title %>" style="--photo-x:<%= ((product.pid - 1) % 6) * 20 %>%;--photo-y:<%= Math.floor((product.pid - 1) / 6) * 100 / 3 %>%"></div><% } else { %><img src="<%= productImage(product.picture) %>" data-fallback="/images/product-placeholder.svg" alt="<%= product.title %>"><% } %></div><section class="detail-copy"><span class="eyebrow"><%= product.name || 'The collection' %></span><h1><%= product.title %></h1><span class="price"><%= money(product.price) %> <small>DA</small></span><p><%= /^Lorem ipsum/i.test(product.details) ? 'Part of the TechStore collection. Take a closer look at this everyday essential and add it to your shopping bag.' : product.details %></p><a class="button full" href="/add-to-cart/pid-<%= product.pid %>">Add to bag <span aria-hidden="true">+</span></a><div class="detail-note"><span aria-hidden="true">&#8599;</span>Update quantities and review your total in the bag.</div><details open><summary>Product details</summary><p>Category: <%= product.name || 'Collection' %><br>Reference: TS-<%= String(product.pid).padStart(4,'0') %><br>Price shown in Algerian dinars (DA).</p></details><details><summary>Need a little help?</summary><p>Visit our <a class="text-link" href="/contact">help page</a> for information about shopping with TechStore.</p></details></section></div><% }); %>
</div>
<% include include/footer.ejs %>
